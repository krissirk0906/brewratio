---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config';
---

<BaseLayout
  title={`404 - Page Not Found | ${site.name}`}
  description="The page you are looking for does not exist or has been moved."
  noindex={true}
>
  <div class="wrap" style="padding: 80px 20px; text-align: center; max-width: 600px;">
    <div style="font-size: 4rem; margin-bottom: 16px;">☕💧</div>
    <h1 style="font-size: 2.5rem; font-weight: 800; color: var(--color-espresso); margin-bottom: 12px;">
      404 - Cup is Empty!
    </h1>
    <p style="font-size: 1.1rem; color: var(--color-text-muted); margin-bottom: 28px;">
      Looks like this brew evaporated or was never poured. Let's head back to the brew bar!
    </p>
    <a href="/" class="btn-primary" style="text-decoration: none;">
      Back to Calculator
    </a>
  </div>
</BaseLayout>
