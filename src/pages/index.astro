---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: site.name,
    url: site.url,
    description: site.description,
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any',
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'USD',
    },
  },
];
---

<BaseLayout
  title={`${site.name} — ${site.tagline}`}
  description={site.description}
  jsonLd={jsonLd}
>
  <!-- Hero Header -->
  <section class="hero wrap">
    <div class="hero-badge">☕ Specialty Coffee Math & Pulse Pour Timer</div>
    <h1>Precision Coffee Ratio Calculator & Pour Timer</h1>
    <p>
      Dial in the exact brew ratio, dose, and water weight to SCA Golden Cup standards. Includes a real-time pulse pour timer with zero external dependencies and synthesized Web Audio chimes.
    </p>
  </section>

  <!-- Interactive Calculator & Timer Section -->
  <section id="calculator" class="wrap calc-container">
    <!-- Left: Inputs & Method Selector -->
    <div class="card">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
        <h2 class="card-title" style="margin-bottom:0;">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="3"/>
            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/>
          </svg>
          1. Select Brewing Method
        </h2>

        <!-- Units Toggle for US/UK -->
        <div style="display:flex; gap:4px; background:var(--color-surface-subtle); padding:3px; border-radius:20px; border:1px solid var(--color-border);" role="radiogroup" aria-label="Units">
          <button type="button" class="pill-btn active" data-unit="metric" style="padding:4px 10px; font-size:0.75rem;">
            Metric (g)
          </button>
          <button type="button" class="pill-btn" data-unit="imperial" style="padding:4px 10px; font-size:0.75rem;">
            US Customary (oz)
          </button>
        </div>
      </div>

      <div class="form-group">
        <label class="form-label">Brewing Equipment:</label>
        <div class="method-pills" role="radiogroup" aria-label="Brew Method">
          <button type="button" class="pill-btn active" data-method="v60">
            <span>🌪️</span> V60 / Pour-Over
          </button>
          <button type="button" class="pill-btn" data-method="french_press">
            <span>🫖</span> French Press
          </button>
          <button type="button" class="pill-btn" data-method="aeropress">
            <span>💉</span> AeroPress
          </button>
          <button type="button" class="pill-btn" data-method="chemex">
            <span>⌛</span> Chemex
          </button>
          <button type="button" class="pill-btn" data-method="drip_machine">
            <span>☕</span> Auto Drip
          </button>
          <button type="button" class="pill-btn" data-method="cold_brew">
            <span>🧊</span> Cold Brew
          </button>
          <button type="button" class="pill-btn" data-method="vietnamese_phin">
            <span>🏮</span> Phin Drip
          </button>
          <button type="button" class="pill-btn" data-method="espresso">
            <span>⚡</span> Espresso
          </button>
        </div>
      </div>

      <div class="form-group" style="margin-top: 24px;">
        <label class="form-label">Calculation Mode:</label>
        <div style="display: flex; gap: 8px; flex-wrap: wrap;">
          <button type="button" class="pill-btn active" data-mode="by_coffee" style="flex:1;">
            By Coffee Dose
          </button>
          <button type="button" class="pill-btn" data-mode="by_water" style="flex:1;">
            By Water to Pour
          </button>
          <button type="button" class="pill-btn" data-mode="by_yield" style="flex:1;">
            By Beverage Yield
          </button>
        </div>
      </div>

      <div class="form-group" style="margin-top: 24px;">
        <label id="amount-label" class="form-label" for="amount-input">Ground Coffee Dose:</label>
        <div class="num-input-wrap">
          <input
            type="number"
            id="amount-input"
            class="num-input"
            value="15"
            min="1"
            max="2000"
            step="0.5"
            aria-label="Input Amount"
          />
          <span id="amount-unit" class="unit-tag">g</span>
        </div>
        <input
          type="range"
          id="amount-slider"
          class="slider-control"
          value="15"
          min="8"
          max="60"
          step="1"
          aria-label="Amount slider"
        />
      </div>

      <div class="form-group" style="margin-top: 24px;">
        <label class="form-label">Strength & Profile:</label>
        <div style="display: flex; gap: 8px;">
          <button type="button" class="pill-btn" data-strength="light" style="flex:1; justify-content:center;">
            🍃 Light / Delicate
          </button>
          <button type="button" class="pill-btn active" data-strength="balanced" style="flex:1; justify-content:center;">
            ⚖️ Balanced (SCA)
          </button>
          <button type="button" class="pill-btn" data-strength="strong" style="flex:1; justify-content:center;">
            🔥 Rich / Bold
          </button>
        </div>
      </div>
    </div>

    <!-- Right: Brew Recipe & Output Card -->
    <div class="card" style="display:flex; flex-direction:column; justify-content:space-between;">
      <div>
        <h2 class="card-title">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
            <polyline points="14 2 14 8 20 8"/>
            <line x1="16" y1="13" x2="8" y2="13"/>
            <line x1="16" y1="17" x2="8" y2="17"/>
            <polyline points="10 9 9 9 8 9"/>
          </svg>
          2. Target Brew Recipe
        </h2>

        <!-- Main Display Well -->
        <div class="output-hero">
          <div class="output-hero-label">Total Water to Pour</div>
          <div id="out-water" class="output-hero-val">240g</div>
          <div class="output-hero-sub">
            Brew Ratio: <strong id="out-ratio" style="color:#FFC872;">1:16</strong> (~62.5 g/L)
          </div>
        </div>

        <div class="stat-grid">
          <div class="stat-box">
            <div class="stat-label">Ground Coffee Dose</div>
            <div id="out-coffee" class="stat-val">15g</div>
          </div>
          <div class="stat-box">
            <div class="stat-label">Estimated Beverage Yield</div>
            <div id="out-yield" class="stat-val">~208.5 ml</div>
          </div>
          <div class="stat-box">
            <div class="stat-label">Bloom Water</div>
            <div id="out-bloom" class="stat-val">45g (45s bloom)</div>
          </div>
          <div class="stat-box">
            <div class="stat-label">Target Brew Time</div>
            <div id="out-brew-time" class="stat-val">3:30</div>
          </div>
        </div>

        <div style="background-color:var(--color-surface-subtle); border-radius:var(--radius-md); padding:14px; border:1px solid var(--color-border); font-size:0.9rem;">
          <div style="margin-bottom:6px;">
            <strong style="color:var(--color-espresso);">🔍 Recommended Grind:</strong> <span id="out-grind">Medium-Fine</span>
          </div>
          <div>
            <strong style="color:var(--color-espresso);">🌡️ Target Water Temp:</strong> <span id="out-temp">198°F - 205°F (92°C - 96°C)</span>
          </div>
        </div>
      </div>

      <div style="margin-top:20px; font-size:0.8rem; color:var(--color-text-subtle); text-align:center;">
        * Accounts for 2.1g of water absorbed per gram of spent coffee grounds.
      </div>
    </div>
  </section>

  <!-- Section 3: Interactive Pulse Pour Timer with Web Audio Chimes -->
  <section id="timer" class="wrap" style="margin-bottom: 60px;">
    <div class="timer-card">
      <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px; margin-bottom:20px;">
        <h2 class="card-title" style="margin-bottom:0;">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/>
            <polyline points="12 6 12 12 16 14"/>
          </svg>
          3. Real-Time Pulse Pour Timer
        </h2>

        <!-- Pulse Strategy Selector -->
        <div style="display:flex; gap:6px; flex-wrap:wrap;">
          <button type="button" class="pill-btn active" data-pulse="three_stage" style="padding:6px 12px; font-size:0.85rem;">
            SCA 3-Stage Pour
          </button>
          <button type="button" class="pill-btn" data-pulse="four_six" style="padding:6px 12px; font-size:0.85rem;">
            Tetsu Kasuya 4:6
          </button>
          <button type="button" class="pill-btn" data-pulse="single_pour" style="padding:6px 12px; font-size:0.85rem;">
            Continuous Single Pour
          </button>
        </div>
      </div>

      <!-- Clock & Status Well -->
      <div class="timer-display">
        <div id="timer-digits" class="timer-digits">00:00</div>
        <div id="timer-step-name" class="timer-status">Ready to brew</div>
        <div class="timer-bar-wrap">
          <div id="timer-bar-fill" class="timer-bar"></div>
        </div>
        <div class="timer-actions">
          <button type="button" id="btn-timer-start" class="btn-timer btn-timer-start">
            ▶ Start Timer
          </button>
          <button type="button" id="btn-timer-reset" class="btn-timer btn-timer-reset">
            ↺ Reset
          </button>
        </div>
      </div>

      <!-- Pulse Pour Schedule List -->
      <div style="margin-top: 28px;">
        <h3 style="font-size: 1.1rem; font-weight: 800; color: var(--color-espresso); margin-bottom: 12px;">
          Pouring Schedule & Intervals
        </h3>
        <div id="pulse-steps-list" style="display: flex; flex-direction: column; gap: 8px;">
          <!-- Dynamically populated by calculator.ts -->
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import '../scripts/calculator.ts';
</script>
