---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    name: `About Us — ${site.name}`,
    description: 'Learn about BrewRatio: open, privacy-friendly specialty coffee calculation and pulse pour timing built for home baristas and coffee enthusiasts.',
  },
];
---

<BaseLayout
  title={`About Us | ${site.name}`}
  description="Discover the mission behind BrewRatio: bringing SCA Golden Cup extraction science and precision pulse pour timing to home brewers worldwide."
  jsonLd={jsonLd}
>
  <div class="wrap" style="padding: 48px 20px 80px; max-width: 820px;">
    <div class="hero-badge">☕ About BrewRatio</div>
    <h1 style="font-size: 2.4rem; font-weight: 800; color: var(--color-espresso); line-height: 1.2; margin-bottom: 24px;">
      About {site.name}
    </h1>

    <div style="color: var(--color-text-muted); font-size: 1.05rem; line-height: 1.7; display: flex; flex-direction: column; gap: 24px;">
      <section class="card">
        <h2 style="font-size: 1.35rem; font-weight: 800; color: var(--color-espresso); margin-bottom: 12px;">
          Our Mission: Demystifying Coffee Extraction
        </h2>
        <p>
          Brewing exceptional pour-over, French press, or drip coffee is not magic—it is a repeatable science grounded in brew ratios, thermal dynamics, water contact time, and ground bed agitation.
        </p>
        <p style="margin-top: 10px;">
          {site.name} was engineered to eliminate kitchen guesswork. Whether you weigh in grams or ounces, use a Hario V60, Chemex, AeroPress, or an automated batch brewer, our tool calculates the exact coffee dose, water mass, and pulse intervals needed for an SCA Golden Cup extraction.
        </p>
      </section>

      <section class="card">
        <h2 style="font-size: 1.35rem; font-weight: 800; color: var(--color-espresso); margin-bottom: 12px;">
          100% Client-Side & Privacy First
        </h2>
        <p>
          Unlike modern apps that demand account logins, bombard you with subscription prompts, or track telemetry back to centralized servers, {site.name} operates entirely within your browser:
        </p>
        <ul style="margin-left: 20px; margin-top: 8px; display: flex; flex-direction: column; gap: 6px;">
          <li><strong>Zero PII Collection:</strong> No emails, accounts, or personal identifying data requested.</li>
          <li><strong>Zero Tracking Cookies:</strong> Your brewing habits stay strictly on your personal device.</li>
          <li><strong>Instant Web Audio:</strong> Interval chimes are synthesized on the fly via the Web Audio API—no bulky audio downloads.</li>
          <li><strong>Blazing Fast:</strong> Static HTML/CSS/TS payload loaded in under 0.5s globally via edge CDNs.</li>
        </ul>
      </section>

      <section class="card">
        <h2 style="font-size: 1.35rem; font-weight: 800; color: var(--color-espresso); margin-bottom: 12px;">
          Trademark & Legal Disclaimers
        </h2>
        <p>
          Hario V60, Chemex, AeroPress, and other equipment names are registered trademarks of their respective owners. {site.name} is an independent educational utility created for coffee hobbyists and professionals. References to commercial brew gear are made strictly under nominative fair use to describe compatibility.
        </p>
      </section>
    </div>
  </div>
</BaseLayout>
