---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config';
---

<BaseLayout
  title={`Privacy Policy | ${site.name}`}
  description="Privacy Policy for BrewRatio: zero personal data collection (Zero PII), no tracking cookies, private by design."
>
  <div class="wrap" style="padding: 48px 20px 80px; max-width: 820px;">
    <h1 style="font-size: 2.4rem; font-weight: 800; color: var(--color-espresso); margin-bottom: 24px;">
      Privacy Policy
    </h1>

    <div class="card" style="display:flex; flex-direction:column; gap:20px; font-size:1rem; line-height:1.7; color:var(--color-text-muted);">
      <div>
        <h2 style="font-size:1.25rem; font-weight:800; color:var(--color-espresso); margin-bottom:8px;">
          1. Zero Personal Data Collection (Zero PII)
        </h2>
        <p>
          {site.name} is a static, client-side web application. All calculations and timers run entirely within your web browser's JavaScript engine. We do not require accounts, sign-ups, email addresses, or any personally identifiable information (PII).
        </p>
      </div>

      <div>
        <h2 style="font-size:1.25rem; font-weight:800; color:var(--color-espresso); margin-bottom:8px;">
          2. Local Processing & Memory
        </h2>
        <p>
          Your brew parameters (dose, water weight, brew method, pulse timer ticks) are processed locally in temporary browser memory. No brewing telemetry, user inputs, or recipe data are transmitted to external servers or databases.
        </p>
      </div>

      <div>
        <h2 style="font-size:1.25rem; font-weight:800; color:var(--color-espresso); margin-bottom:8px;">
          3. Cookies & Advertising
        </h2>
        <p>
          {site.name} does not set first-party tracking cookies. Third-party advertising partners (such as Google AdSense) may serve ads and use cookies or web beacons to display relevant advertising based on previous visits, in accordance with Google's standard privacy policies.
        </p>
      </div>

      <div>
        <h2 style="font-size:1.25rem; font-weight:800; color:var(--color-espresso); margin-bottom:8px;">
          4. Contact Us
        </h2>
        <p>
          If you have questions regarding this Privacy Policy or privacy practices, please contact the development team through our public repository.
        </p>
      </div>
    </div>
  </div>
</BaseLayout>
