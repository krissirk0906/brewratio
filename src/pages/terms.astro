---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config';
---

<BaseLayout
  title={`Terms of Use | ${site.name}`}
  description="Terms of Use for BrewRatio: free, independent, open-access specialty coffee ratio calculator and timer utility."
>
  <div class="wrap" style="padding: 48px 20px 80px; max-width: 820px;">
    <h1 style="font-size: 2.4rem; font-weight: 800; color: var(--color-espresso); margin-bottom: 24px;">
      Terms of Use
    </h1>

    <div class="card" style="display:flex; flex-direction:column; gap:20px; font-size:1rem; line-height:1.7; color:var(--color-text-muted);">
      <div>
        <h2 style="font-size:1.25rem; font-weight:800; color:var(--color-espresso); margin-bottom:8px;">
          1. Acceptance of Terms
        </h2>
        <p>
          By accessing or using {site.name}, you agree to be bound by these Terms of Use. If you disagree with any part of these terms, please discontinue use of the service.
        </p>
      </div>

      <div>
        <h2 style="font-size:1.25rem; font-weight:800; color:var(--color-espresso); margin-bottom:8px;">
          2. Educational & Informational Utility
        </h2>
        <p>
          {site.name} provides mathematical formulas and timing schedules based on publicly referenced standards from the specialty coffee industry (e.g., Specialty Coffee Association Golden Cup standards). The metrics and recommendations are provided for informational and recipe-optimization purposes.
        </p>
      </div>

      <div>
        <h2 style="font-size:1.25rem; font-weight:800; color:var(--color-espresso); margin-bottom:8px;">
          3. Trademark Disclaimer
        </h2>
        <p>
          All product names, logos, brands, trademarks, and registered trademarks (including but not limited to Hario V60, Chemex, and AeroPress) are property of their respective owners. Their mention does not imply endorsement, affiliation, sponsorship, or certification.
        </p>
      </div>

      <div>
        <h2 style="font-size:1.25rem; font-weight:800; color:var(--color-espresso); margin-bottom:8px;">
          4. Limitation of Liability
        </h2>
        <p>
          This website is provided "as is" without warranty of any kind. The creators and publishers shall not be liable for any direct, indirect, incidental, or consequential damages resulting from the handling of boiling water, brewing apparatus, or kitchen appliances during usage of the timer.
        </p>
      </div>
    </div>
  </div>
</BaseLayout>
